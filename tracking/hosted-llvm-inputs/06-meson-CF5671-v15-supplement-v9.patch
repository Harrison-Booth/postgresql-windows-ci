index 0000000..dd00293
--- /dev/null
+++ b/config/export-pgxs-flags.py
@@ -0,0 +1,107 @@
+#!/usr/bin/env python3
+"""Export resolved Meson dependency arguments to PGXS and pg_config."""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import re
+import sys
+
+
+def shell_flags(arguments):
+    quoted = []
+    for argument in arguments:
+        if '\n' in argument or '\r' in argument:
+            raise ValueError('cannot export compiler arguments containing line breaks to PGXS')
+        escaped = re.sub(r'([\\"$`])', r'\\\1', argument)
+        quoted.append('"' + escaped + '"')
+    return ' '.join(quoted)
+
+
+def make_value(value):
+    # Make processes dollars and comments before the shell sees quoting.
+    value = value.replace('$', '$$')
+    return re.sub(r'(\\*)#', lambda match: '\\' * (2 * len(match.group(1)) + 1) + '#', value)
+
+
+def c_string(value):
+    escaped = []
+    for byte in value.encode('utf-8'):
+        if byte in (34, 92):
+            escaped.append('\\' + chr(byte))
+        elif 32 <= byte < 127:
+            escaped.append(chr(byte))
+        else:
+            escaped.append('\\%03o' % byte)
+    return '"' + ''.join(escaped) + '"'
+
+
+def write_changed(path, content):
+    if not path.exists() or path.read_text(encoding='utf-8') != content:
+        with path.open('w', encoding='utf-8', newline=os.linesep) as output:
+            output.write(content)
+
+
+def dependency_flags(dependencies, names):
+    result = []
+    for name in names:
+        matches = [dependency for dependency in dependencies if dependency['name'] == name]
+        if len(matches) != 1:
+            raise ValueError('expected one resolved dependency named %r, found %d' % (name, len(matches)))
+        flags = matches[0]['compile_args']
+        if not isinstance(flags, list) or not all(isinstance(flag, str) for flag in flags):
+            raise ValueError('invalid compile arguments for dependency %r' % name)
+        result.extend(flags)
+    return result
+
+
+def main():
+    # Keep final outputs intact during reconfiguration. Meson still declares
+    # them as configure_file outputs; post-configuration supplies new values.
+    if len(sys.argv) == 3 and sys.argv[1] == '--init-header':
+        path = Path(sys.argv[2])
+        text = path.read_text(encoding='utf-8') if path.exists() else '#define VAL_CPPFLAGS ""\n'
+        sys.stdout.buffer.write(text.encode('utf-8'))
+        return
+    if len(sys.argv) == 4 and sys.argv[1] == '--init-makefile':
+        path = Path(sys.argv[3])
+        text = (path if path.exists() else Path(sys.argv[2])).read_text(encoding='utf-8')
+        sys.stdout.buffer.write(text.encode('utf-8'))
+        return
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--makefile', required=True)
+    parser.add_argument('--template', required=True)
+    parser.add_argument('--header', required=True)
+    parser.add_argument('--ssl', action='append', default=[])
+    parser.add_argument('--icu', action='append', default=[])
+    parser.add_argument('--cppflag', action='append', default=[])
+    parser.add_argument('--bitcode-cflag', action='append', default=[])
+    parser.add_argument('--bitcode-cxxflag', action='append', default=[])
+    arguments = parser.parse_args()
+    build = Path(os.environ['MESON_BUILD_ROOT'])
+    dependencies = json.loads((build / 'meson-info' / 'intro-dependencies.json').read_text(encoding='utf-8'))
+    ssl = dependency_flags(dependencies, arguments.ssl)
+    icu = dependency_flags(dependencies, arguments.icu)
+    # ICU_CFLAGS remains separate for PGXS compatibility. pg_config reports
+    # all preprocessing flags needed by an extension.
+    cppflags = arguments.cppflag + ssl
+    path = Path(arguments.makefile)
+    text = Path(arguments.template).read_text(encoding='utf-8')
+    exports = [('CPPFLAGS', cppflags), ('ICU_CFLAGS', icu)]
+    if arguments.bitcode_cflag or arguments.bitcode_cxxflag:
+        exports += [('BITCODE_CFLAGS', arguments.bitcode_cflag),
+                    ('BITCODE_CXXFLAGS', arguments.bitcode_cxxflag)]
+    for name, flags in exports:
+        value = make_value(shell_flags(flags))
+        text, count = re.subn(r'^' + name + r'[ \t]*=.*$', lambda match: name + ' = ' + value, text, flags=re.MULTILINE)
+        if count != 1:
+            raise ValueError('expected one %s assignment, found %d' % (name, count))
+    write_changed(path, text)
+    header = '/* Generated by Meson post-configuration dependency export. */\n'
+    header += '#define VAL_CPPFLAGS ' + c_string(shell_flags(cppflags + icu)) + '\n'
+    write_changed(Path(arguments.header), header)
+
+
+if __name__ == '__main__':
+    main()
