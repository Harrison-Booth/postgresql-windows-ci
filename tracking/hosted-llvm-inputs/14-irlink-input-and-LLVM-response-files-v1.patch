diff --git a/src/tools/irlink b/src/tools/irlink
--- a/src/tools/irlink
+++ b/src/tools/irlink
@@ -6,6 +6,7 @@
 import argparse
 import os
 import subprocess
+import tempfile
 
 parser = argparse.ArgumentParser(
     description='generate PostgreSQL JIT IR module')
@@ -13,14 +14,31 @@
 parser.add_argument('--index', type=str, required=True)
 parser.add_argument('--lto', type=str, required=True)
 parser.add_argument('--outdir', type=str, required=True)
-parser.add_argument('INPUT', type=str, nargs='+')
+parser.add_argument('--input-list', type=str)
+parser.add_argument('INPUT', type=str, nargs='*')
 
 args = parser.parse_args()
+if args.input_list:
+    with open(args.input_list, encoding='utf-8') as inputs:
+        args.INPUT.extend(line.rstrip('\r\n') for line in inputs if line.rstrip('\r\n'))
+if not args.INPUT:
+    parser.error('at least one bitcode input is required')
 
 file_names = [os.path.basename(f) for f in args.INPUT]
-command = [args.lto,
-           '-thinlto', '-thinlto-action=thinlink',
-           '-o', args.index] + file_names
-res = subprocess.run(command, cwd=args.outdir)
+# LLVM accepts response files. Use one here too: shortening the Meson command
+# alone would move the same command-length failure into this child process.
+with tempfile.NamedTemporaryFile(mode='w', encoding='utf-8',
+                                 suffix='.rsp', dir=args.outdir,
+                                 delete=False) as response:
+    for name in file_names:
+        response.write('"' + name.replace('\\', '\\\\').replace('"', '\\"') + '"\n')
+    response_name = os.path.abspath(response.name)
+
+try:
+    command = [args.lto, '-thinlto', '-thinlto-action=thinlink',
+               '-o', args.index, '@' + response_name]
+    res = subprocess.run(command, cwd=args.outdir)
+finally:
+    os.unlink(response_name)
 
 exit(res.returncode)
