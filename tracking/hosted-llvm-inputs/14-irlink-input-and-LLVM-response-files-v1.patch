@@ -35,11 +35,23 @@
     )
   endforeach
 
+  # Keep the complete dependency graph without expanding all bitcode paths
+  # onto the process command line, which can exceed Windows' limit.
+  bitcode_inputs = []
+  foreach bitcode_target : bitcode_targets
+    bitcode_inputs += bitcode_target.full_path()
