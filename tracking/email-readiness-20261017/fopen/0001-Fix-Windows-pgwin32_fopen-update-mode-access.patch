From 71517a0886997dfe3c484354cd09e43989464efc Mon Sep 17 00:00:00 2001
From: Harrison Booth <harrisontbooth@gmail.com>
Date: Wed, 14 Oct 2026 16:20:42 -0500
Subject: [PATCH] Fix Windows pgwin32_fopen update-mode access

Handle + independently when selecting Windows fopen access rights, so
rb+/wb+ and append update modes request read/write access. Preserve
creation, truncation, append and text/binary mode behavior.

Add a frontend libpgport regression covering update spellings,
missing/existing files, append positioning and text/binary bytes.
---
 src/port/open.c                             |  14 +-
 src/test/modules/Makefile                   |   1 +
 src/test/modules/meson.build                |   1 +
 src/test/modules/test_pgport/Makefile       |  18 +++
 src/test/modules/test_pgport/README         |  13 ++
 src/test/modules/test_pgport/meson.build    |  22 ++++
 src/test/modules/test_pgport/t/001_fopen.pl |  23 ++++
 src/test/modules/test_pgport/test_fopen.c   | 136 ++++++++++++++++++++
 8 files changed, 222 insertions(+), 6 deletions(-)
 create mode 100644 src/test/modules/test_pgport/Makefile
 create mode 100644 src/test/modules/test_pgport/README
 create mode 100644 src/test/modules/test_pgport/meson.build
 create mode 100644 src/test/modules/test_pgport/t/001_fopen.pl
 create mode 100644 src/test/modules/test_pgport/test_fopen.c

diff --git a/src/port/open.c b/src/port/open.c
index 4be08b2cf133212cb5372f004c8ccf026096e41b..93ae02df06e5aae1527d84e920c7543831ca780b 100644
--- a/src/port/open.c
+++ b/src/port/open.c
@@ -207,17 +207,19 @@ pgwin32_fopen(const char *fileName, const char *mode)
 	int			openmode = 0;
 	int			fd;
 
-	if (strstr(mode, "r+"))
-		openmode |= O_RDWR;
-	else if (strchr(mode, 'r'))
+	if (strchr(mode, 'r'))
 		openmode |= O_RDONLY;
-	if (strstr(mode, "w+"))
-		openmode |= O_RDWR | O_CREAT | O_TRUNC;
-	else if (strchr(mode, 'w'))
+	if (strchr(mode, 'w'))
 		openmode |= O_WRONLY | O_CREAT | O_TRUNC;
 	if (strchr(mode, 'a'))
 		openmode |= O_WRONLY | O_CREAT | O_APPEND;
 
+	if (strchr(mode, '+'))
+	{
+		openmode &= ~O_WRONLY;
+		openmode |= O_RDWR;
+	}
+
 	if (strchr(mode, 'b'))
 		openmode |= O_BINARY;
 	if (strchr(mode, 't'))
