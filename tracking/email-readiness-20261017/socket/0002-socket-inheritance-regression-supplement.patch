 src/bin/pg_ctl/meson.build                    |  10 +
 .../pg_ctl/t/005_socket_handle_inheritance.pl | 236 ++++++++++--------
 src/bin/pg_ctl/t/meson.build                  |  10 +
 src/bin/pg_ctl/t/socket_copy_helper.c         |  79 ++++++
 5 files changed, 236 insertions(+), 110 deletions(-)
